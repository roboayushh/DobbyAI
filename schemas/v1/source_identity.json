{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness/schemas/v1/source_identity.json",
  "title": "SourceIdentityV1",
  "type": "object",
  "required": [
    "schema_version",
    "source_kind",
    "canonical_locator",
    "baseline_commit",
    "baseline_tree",
    "content_tree_sha256",
    "import_manifest_sha256",
    "dirty_source_imported",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "source_kind": {
      "type": "string",
      "enum": ["local_git", "public_https"]
    },
    "canonical_locator": {
      "type": "string"
    },
    "upstream_commit": {
      "type": ["string", "null"]
    },
    "baseline_commit": {
      "type": "string"
    },
    "baseline_tree": {
      "type": "string"
    },
    "content_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "import_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dirty_source_imported": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    }
  }
}
