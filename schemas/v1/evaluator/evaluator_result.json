{
  "$defs": {
    "PendingApprovalV1": {
      "additionalProperties": false,
      "properties": {
        "capability_request_id": {
          "title": "Capability Request Id",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "capability_request_id",
        "operation",
        "summary"
      ],
      "title": "PendingApprovalV1",
      "type": "object"
    },
    "ResultCandidateV1": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{4,64}$",
          "title": "Commit",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{4,64}$",
          "title": "Tree",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree",
        "content_sha256"
      ],
      "title": "ResultCandidateV1",
      "type": "object"
    },
    "ResultExportV1": {
      "additionalProperties": false,
      "properties": {
        "bundle_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bundle Path"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Sha256"
        },
        "patch_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patch Sha256"
        },
        "status": {
          "enum": [
            "VALID",
            "INVALID",
            "FAILED",
            "NOT_REQUESTED",
            "EXPORT_INVALID"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "ResultExportV1",
      "type": "object"
    },
    "ResultInputV1": {
      "additionalProperties": false,
      "properties": {
        "baseline_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Commit"
        },
        "baseline_tree": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Tree"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        }
      },
      "title": "ResultInputV1",
      "type": "object"
    },
    "ResultTaskV1": {
      "additionalProperties": false,
      "properties": {
        "changed_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 2000,
          "title": "Changed Paths",
          "type": "array"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "verification_report_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Report Artifact Id"
        }
      },
      "required": [
        "task_id",
        "status"
      ],
      "title": "ResultTaskV1",
      "type": "object"
    },
    "ResultUsageV1": {
      "additionalProperties": false,
      "properties": {
        "estimated_fields": {
          "items": {
            "type": "string"
          },
          "title": "Estimated Fields",
          "type": "array"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_calls": {
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "wall_seconds": {
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "model_calls",
        "input_tokens",
        "output_tokens",
        "wall_seconds"
      ],
      "title": "ResultUsageV1",
      "type": "object"
    },
    "ResultVerificationV1": {
      "additionalProperties": false,
      "properties": {
        "aggregate_report_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregate Report Artifact Id"
        },
        "failed_checks": {
          "minimum": 0,
          "title": "Failed Checks",
          "type": "integer"
        },
        "passed_checks": {
          "minimum": 0,
          "title": "Passed Checks",
          "type": "integer"
        },
        "required_checks": {
          "minimum": 0,
          "title": "Required Checks",
          "type": "integer"
        },
        "skipped_checks": {
          "minimum": 0,
          "title": "Skipped Checks",
          "type": "integer"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "unavailable_checks": {
          "minimum": 0,
          "title": "Unavailable Checks",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "required_checks",
        "passed_checks",
        "failed_checks",
        "skipped_checks",
        "unavailable_checks"
      ],
      "title": "ResultVerificationV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResultCandidateV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "exit_code": {
      "title": "Exit Code",
      "type": "integer"
    },
    "export": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResultExportV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input": {
      "$ref": "#/$defs/ResultInputV1"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Limitations",
      "type": "array"
    },
    "pending_approvals": {
      "items": {
        "$ref": "#/$defs/PendingApprovalV1"
      },
      "title": "Pending Approvals",
      "type": "array"
    },
    "reproducibility_manifest_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reproducibility Manifest Artifact Id"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "settled_at": {
      "title": "Settled At",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "COMPLETED_ALL",
        "PARTIAL_SUCCESS",
        "FAILED",
        "UNVERIFIED",
        "BLOCKED_ENVIRONMENT",
        "BUDGET_EXHAUSTED",
        "NEEDS_INPUT",
        "PENDING_APPROVAL",
        "CANCELLED",
        "INVALID",
        "INTEGRATION_UNCERTAIN",
        "INTERNAL_ERROR"
      ],
      "title": "Status",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/ResultTaskV1"
      },
      "maxItems": 20,
      "title": "Tasks",
      "type": "array"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResultUsageV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResultVerificationV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "status",
    "exit_code",
    "settled_at"
  ],
  "title": "EvaluatorResultV1",
  "type": "object"
}
