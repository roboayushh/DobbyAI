{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness/schemas/v1/error_result.json",
  "title": "ErrorResultV1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": ["FAILED", "BLOCKED", "CANCELLED"]
    },
    "run_id": {
      "type": ["string", "null"]
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable", "details"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    }
  }
}
