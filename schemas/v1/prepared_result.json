{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness/schemas/v1/prepared_result.json",
  "title": "PreparedRunResultV1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "task_mode",
    "execution_mode",
    "source",
    "workspace",
    "tasks",
    "queue_summary",
    "artifacts",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "const": "PREPARED"
    },
    "task_mode": {
      "type": "string",
      "enum": ["single_issue", "repository"]
    },
    "execution_mode": {
      "type": "string",
      "enum": ["development", "evaluation"]
    },
    "source": {
      "type": "object",
      "required": ["baseline_commit", "content_tree_sha256"],
      "additionalProperties": false,
      "properties": {
        "upstream_commit": {
          "type": ["string", "null"]
        },
        "baseline_commit": {
          "type": "string"
        },
        "content_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "workspace": {
      "type": "object",
      "required": ["workspace_id", "relative_root", "writable"],
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string"
        },
        "relative_root": {
          "type": "string"
        },
        "writable": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "ordinal", "state"],
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "enum": ["QUEUED", "BLOCKED", "CANCELLED"]
          }
        }
      }
    },
    "queue_summary": {
      "type": "object",
      "required": ["discovered", "excluded", "duplicates", "selected", "remaining"],
      "additionalProperties": false,
      "properties": {
        "discovered": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 },
        "selected": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "sha256", "relative_path"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "relative_path": { "type": "string" }
        }
      }
    },
    "created_at": {
      "type": "string"
    }
  }
}
