          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "statement",
        "confidence"
      ],
      "title": "HypothesisV1",
      "type": "object"
    },
    "PlanStepV1": {
