          "type": "string"
        },
        "evidence_needed": {
          "title": "Evidence Needed",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "statement",
        "evidence_needed"
      ],
      "title": "AcceptanceCriterionV1",
      "type": "object"
    },
    "EditLocationV1": {
