          "title": "Status",
          "type": "string"
        },
        "verification_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Verification Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "verification_id",
        "contract_set_sha256",
        "report_artifact_id"
      ],
      "title": "PostAdvanceVerificationV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
