      "maxLength": 128,
      "minLength": 1,
      "title": "Integration Intent Id",
      "type": "string"
    },
    "integration_result_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Integration Result Id",
      "type": "string"
    },
    "integration_sequence": {
      "minimum": 0,
      "title": "Integration Sequence",
      "type": "integer"
    },
    "observed_after_commit": {
      "maxLength": 128,
      "minLength": 4,
      "title": "Observed After Commit",
      "type": "string"
    },
    "observed_before_commit": {
      "maxLength": 128,
      "minLength": 4,
      "title": "Observed Before Commit",
      "type": "string"
    },
    "post_advance_verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/PostAdvanceVerificationV1"
