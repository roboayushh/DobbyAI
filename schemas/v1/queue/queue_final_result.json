{
  "$defs": {
    "AggregateVerificationV1": {
      "additionalProperties": false,
      "properties": {
        "contract_set_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Set Sha256"
        },
        "report_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Artifact Id"
        },
        "status": {
          "enum": [
            "PASS",
            "FAILED",
            "UNVERIFIED",
            "BLOCKED_ENVIRONMENT",
            "BUDGET_EXHAUSTED",
            "NEEDS_INPUT",
            "CANCELLED",
            "NOT_RUN"
          ],
          "title": "Status",
          "type": "string"
        },
        "verification_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Id"
        }
      },
      "required": [
        "status"
      ],
      "title": "AggregateVerificationV1",
      "type": "object"
    },
    "FinalCountsV1": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "minimum": 0,
          "title": "Blocked",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "integrated": {
          "minimum": 0,
          "title": "Integrated",
          "type": "integer"
        },
        "remaining": {
          "minimum": 0,
          "title": "Remaining",
          "type": "integer"
        },
        "selected": {
          "minimum": 0,
          "title": "Selected",
          "type": "integer"
        }
      },
      "required": [
        "selected",
        "integrated",
        "failed",
        "blocked",
        "remaining"
      ],
      "title": "FinalCountsV1",
      "type": "object"
    },
    "FinalIntegrationV1": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "maxLength": 128,
          "minLength": 4,
          "title": "Commit",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "tree": {
          "maxLength": 128,
          "minLength": 4,
          "title": "Tree",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree",
        "sequence"
      ],
      "title": "FinalIntegrationV1",
      "type": "object"
    },
    "GitIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "maxLength": 128,
          "minLength": 4,
          "title": "Commit",
          "type": "string"
        },
        "object_format": {
          "default": "sha1",
          "enum": [
            "sha1",
            "sha256"
          ],
          "title": "Object Format",
          "type": "string"
        },
        "tree": {
          "maxLength": 128,
          "minLength": 4,
          "title": "Tree",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "title": "GitIdentityV1",
      "type": "object"
    },
    "TaskResultEntryV1": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "status"
      ],
      "title": "TaskResultEntryV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregate_verification": {
      "$ref": "#/$defs/AggregateVerificationV1"
    },
    "baseline": {
      "$ref": "#/$defs/GitIdentityV1"
    },
    "counts": {
      "$ref": "#/$defs/FinalCountsV1"
    },
    "final_integration": {
      "$ref": "#/$defs/FinalIntegrationV1"
    },
    "final_patch_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Patch Artifact Id"
    },
    "publication_authorized": {
      "const": false,
      "default": false,
      "enum": [
        false
      ],
      "title": "Publication Authorized",
      "type": "boolean"
    },
    "queue_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Queue Id",
      "type": "string"
    },
    "queue_report_artifact_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Queue Report Artifact Id",
      "type": "string"
    },
    "queue_version_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Queue Version Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "enum": [
        "1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "settled_at": {
      "title": "Settled At",
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETED_ALL",
        "PARTIAL_SUCCESS",
        "FAILED",
        "UNVERIFIED",
        "BLOCKED_ENVIRONMENT",
        "BUDGET_EXHAUSTED",
        "NEEDS_INPUT",
        "CANCELLED",
        "INTEGRATION_UNCERTAIN",
        "INVALID"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_results": {
      "items": {
        "$ref": "#/$defs/TaskResultEntryV1"
      },
      "maxItems": 20,
      "title": "Task Results",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "queue_id",
    "queue_version_id",
    "status",
    "baseline",
    "final_integration",
    "aggregate_verification",
    "counts",
    "task_results",
    "queue_report_artifact_id",
    "settled_at"
  ],
  "title": "QueueFinalResultV1",
  "type": "object"
}
