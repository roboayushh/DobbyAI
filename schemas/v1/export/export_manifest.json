{
  "$defs": {
    "ExportCandidateV1": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{4,64}$",
          "title": "Commit",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{4,64}$",
          "title": "Tree",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree",
        "content_sha256"
      ],
      "title": "ExportCandidateV1",
      "type": "object"
    },
    "ExportFileV1": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "media_type",
        "bytes",
        "sha256"
      ],
      "title": "ExportFileV1",
      "type": "object"
    },
    "GitPointV1": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{4,64}$",
          "title": "Commit",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{4,64}$",
          "title": "Tree",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "title": "GitPointV1",
      "type": "object"
    },
    "RoundTripV1": {
      "additionalProperties": false,
      "properties": {
        "report_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Artifact Id"
        },
        "result_tree": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Tree"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED_ENVIRONMENT",
            "CANCELLED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "RoundTripV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base": {
      "$ref": "#/$defs/GitPointV1"
    },
    "candidate": {
      "$ref": "#/$defs/ExportCandidateV1"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "export_id": {
      "title": "Export Id",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ExportFileV1"
      },
      "title": "Files",
      "type": "array"
    },
    "format": {
      "const": "unified_git_patch_v1",
      "default": "unified_git_patch_v1",
      "enum": [
        "unified_git_patch_v1"
      ],
      "title": "Format",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "round_trip": {
      "$ref": "#/$defs/RoundTripV1"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "VALID",
        "INVALID",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "export_id",
    "run_id",
    "status",
    "base",
    "candidate",
    "files",
    "round_trip",
    "manifest_sha256",
    "created_at"
  ],
  "title": "ExportManifestV1",
  "type": "object"
}
