          "pattern": "^[0-9a-f]{4,64}$",
          "title": "Base Commit",
          "type": "string"
        },
        "head_commit": {
          "pattern": "^[0-9a-f]{4,64}$",
          "title": "Head Commit",
          "type": "string"
        },
        "head_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Head Content Sha256",
          "type": "string"
        },
        "head_tree": {
          "pattern": "^[0-9a-f]{4,64}$",
          "title": "Head Tree",
          "type": "string"
        }
      },
      "required": [
        "base_commit",
        "head_commit",
        "head_tree",
        "head_content_sha256"
      ],
      "title": "ExportCandidateRefV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
