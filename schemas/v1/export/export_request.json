    },
    "export_request_id": {
      "title": "Export Request Id",
      "type": "string"
    },
    "format": {
      "const": "unified_git_patch_v1",
      "default": "unified_git_patch_v1",
      "enum": [
        "unified_git_patch_v1"
      ],
      "title": "Format",
      "type": "string"
    },
    "include_artifact_kinds": {
      "items": {
        "enum": [
          "verification_summary",
          "task_results",
          "usage",
          "provenance"
        ],
        "type": "string"
      },
      "title": "Include Artifact Kinds",
      "type": "array"
    },
    "max_bundle_bytes": {
      "default": 25000000,
      "exclusiveMinimum": 0,
      "maximum": 536870912,
      "title": "Max Bundle Bytes",
      "type": "integer"
    },
    "output_path": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Output Path",
      "type": "string"
    },
    "release_handoff_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Handoff Artifact Id"
    },
    "replace_existing": {
      "default": false,
      "title": "Replace Existing",
      "type": "boolean"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "export_request_id",
    "run_id",
    "candidate",
    "output_path",
    "request_sha256"
