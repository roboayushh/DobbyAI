{
  "$defs": {
    "ActionReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "settlement": {
          "title": "Settlement",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "settlement"
      ],
      "title": "ActionReferenceV1",
      "type": "object"
    },
    "CandidateReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "changed_paths": {
          "items": {
            "type": "string"
          },
          "title": "Changed Paths",
          "type": "array"
        },
        "commit": {
          "title": "Commit",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "commit",
        "candidate_sha256"
      ],
      "title": "CandidateReferenceV1",
      "type": "object"
    },
    "MaterialQuestionV1": {
      "additionalProperties": false,
      "properties": {
        "impact": {
          "title": "Impact",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "impact"
      ],
      "title": "MaterialQuestionV1",
      "type": "object"
    },
    "OrchestrationState": {
      "enum": [
        "PREPARED",
        "INDEXING",
        "PLANNING",
        "PLAN_READY",
        "CODING",
        "REPLANNING",
        "ACTION_PROPOSED",
        "VERIFICATION_REQUIRED",
        "NEEDS_INPUT",
        "NEEDS_CAPABILITY",
        "BUDGET_EXHAUSTED",
        "FAILED",
        "CANCELLED",
        "ACTION_EXECUTING",
        "NEEDS_APPROVAL",
        "BLOCKED_ENVIRONMENT",
        "ACTION_UNKNOWN",
        "VERIFYING",
        "REPAIRING",
        "READY_FOR_REVIEW",
        "VERIFICATION_FAILED",
        "UNVERIFIED",
        "QUEUE_SETTLED"
      ],
      "title": "OrchestrationState",
      "type": "string"
    },
    "PhaseUsageV1": {
      "additionalProperties": false,
      "properties": {
        "elapsed_seconds": {
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "integer"
        },
        "input_tokens_used": {
          "minimum": 0,
          "title": "Input Tokens Used",
          "type": "integer"
        },
        "model_calls_used": {
          "minimum": 0,
          "title": "Model Calls Used",
          "type": "integer"
        },
        "output_tokens_used": {
          "minimum": 0,
          "title": "Output Tokens Used",
          "type": "integer"
        },
        "verification_calls_reserved": {
          "minimum": 2,
          "title": "Verification Calls Reserved",
          "type": "integer"
        }
      },
      "required": [
        "model_calls_used",
        "input_tokens_used",
        "output_tokens_used",
        "elapsed_seconds",
        "verification_calls_reserved"
      ],
      "title": "PhaseUsageV1",
      "type": "object"
    },
    "PlanReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "plan_id",
        "revision"
      ],
      "title": "PlanReferenceV1",
      "type": "object"
    },
    "ProposalReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "action_proposal_id": {
          "title": "Action Proposal Id",
          "type": "string"
        },
        "decision": {
          "const": "CODE",
          "enum": [
            "CODE"
          ],
          "title": "Decision",
          "type": "string"
        },
        "proposal_artifact_id": {
          "title": "Proposal Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "action_proposal_id",
        "proposal_artifact_id",
        "decision"
      ],
      "title": "ProposalReferenceV1",
      "type": "object"
    },
    "VerificationReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "completion_decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Decision Id"
        },
        "repair_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Repair Attempts",
          "type": "integer"
        },
        "report_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Artifact Id"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "VerificationReferenceV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions_executed": {
      "default": 0,
      "minimum": 0,
      "title": "Actions Executed",
      "type": "integer"
    },
    "approval_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Request Id"
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateReferenceV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "last_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionReferenceV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "next_required_prd": {
      "anyOf": [
        {
          "enum": [
            3,
            4,
            5
          ],
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Required Prd"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanReferenceV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposalReferenceV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/MaterialQuestionV1"
      },
      "title": "Questions",
      "type": "array"
    },
    "remaining_repository_tasks": {
      "minimum": 0,
      "title": "Remaining Repository Tasks",
      "type": "integer"
    },
    "required_capability": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Required Capability"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "enum": [
        "1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "title": "Source Revision",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/OrchestrationState"
    },
    "stop_reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason Code"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/PhaseUsageV1"
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationReferenceV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workspace_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Version"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "status",
    "source_revision",
    "usage",
    "remaining_repository_tasks",
    "created_at"
  ],
  "title": "OrchestrationPhaseResultV1",
  "type": "object"
}
