{
  "$defs": {
    "EffectPluginRefV1": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "content_sha256"
      ],
      "title": "EffectPluginRefV1",
      "type": "object"
    },
    "EffectTargetV1": {
      "additionalProperties": false,
      "properties": {
        "desired_oid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desired Oid"
        },
        "expected_oid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Oid"
        },
        "local_root_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Root Identity"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "repository_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Identity"
        }
      },
      "title": "EffectTargetV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_consumption_id": {
      "title": "Approval Consumption Id",
      "type": "string"
    },
    "approval_grant_id": {
      "title": "Approval Grant Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "credential_scope_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Scope Id"
    },
    "effect_intent_id": {
      "title": "Effect Intent Id",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "operation": {
      "enum": [
        "APPLY_LOCAL",
        "PUSH_NEW_BRANCH",
        "CLEANUP_RUN"
      ],
      "title": "Operation",
      "type": "string"
    },
    "plugin": {
      "$ref": "#/$defs/EffectPluginRefV1"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Commit"
    },
    "state": {
      "enum": [
        "PREPARED",
        "DISPATCHED",
        "OBSERVING",
        "SETTLED",
        "NOT_APPLIED",
        "FAILED",
        "UNCERTAIN"
      ],
      "title": "State",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/EffectTargetV1"
    }
  },
  "required": [
    "effect_intent_id",
    "run_id",
    "operation",
    "approval_grant_id",
    "approval_consumption_id",
    "plugin",
    "target",
    "idempotency_key",
    "state",
    "intent_sha256",
    "created_at"
  ],
  "title": "ExternalEffectIntentV1",
  "type": "object"
}
