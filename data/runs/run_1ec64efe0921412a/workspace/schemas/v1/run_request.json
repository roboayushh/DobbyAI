{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness/schemas/v1/run_request.json",
  "title": "RunRequestV1",
  "type": "object",
  "required": [
    "schema_version",
    "idempotency_key",
    "task_mode",
    "execution_mode",
    "repository",
    "task"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "task_mode": {
      "type": "string",
      "enum": ["single_issue", "repository"]
    },
    "execution_mode": {
      "type": "string",
      "enum": ["development", "evaluation"]
    },
    "repository": {
      "type": "object",
      "required": ["kind", "locator"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["local_git", "public_https"]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": ["string", "null"]
        },
        "expected_tree_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue_snapshot_id": {
          "type": ["string", "null"]
        },
        "issue_url": {
          "type": ["string", "null"]
        },
        "text": {
          "type": ["string", "null"]
        },
        "repository_query": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "default": "open"
            },
            "include_labels": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "exclude_labels": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "priority_labels": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "assignee": {
              "type": ["string", "null"],
              "default": null
            },
            "milestone": {
              "type": ["string", "null"],
              "default": null
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 3
        },
        "max_discovery_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50
        },
        "max_issue_body_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1000000,
          "default": 200000
        },
        "repo_acquire_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1800,
          "default": 300
        },
        "max_repo_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 10737418240,
          "default": 2147483648
        },
        "max_file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 250000
        }
      }
    },
    "runtime_profile": {
      "type": "string",
      "default": "local-default"
    },
    "evaluation_profile": {
      "type": ["string", "null"],
      "default": null
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  }
}
