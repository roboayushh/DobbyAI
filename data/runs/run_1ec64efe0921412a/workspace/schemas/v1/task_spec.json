{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness/schemas/v1/task_spec.json",
  "title": "TaskSpecV1",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "ordinal",
    "source_type",
    "source_key",
    "title",
    "body",
    "labels",
    "remote_state",
    "raw_content_sha256",
    "normalized_content_sha256",
    "dependencies",
    "trust"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "source_type": {
      "type": "string",
      "enum": ["github_issue", "direct_text"]
    },
    "source_key": {
      "type": "string"
    },
    "source_snapshot_id": {
      "type": ["string", "null"]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "remote_state": {
      "type": "string"
    },
    "remote_created_at": {
      "type": ["string", "null"]
    },
    "remote_updated_at": {
      "type": ["string", "null"]
    },
    "raw_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalized_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "trust": {
      "type": "string",
      "default": "untrusted_input"
    }
  }
}
